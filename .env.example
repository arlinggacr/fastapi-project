# --- app ---
APP_NAME=Auction API
DEBUG=false
ENABLE_DOCS=true
CORS_ORIGINS=["http://localhost:3000"]

# --- database (Neon) ---
DB_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- redis (Upstash) ---
# REST endpoint (works everywhere; WebSockets poll Redis Streams)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Optional native TCP endpoint (enables real pub/sub push, lowest latency).
# Copy it from the Upstash console -> Connect -> redis-cli.
# REDIS_URL=rediss://default:PASSWORD@xxx.upstash.io:6379

KEY_PREFIX=auction
REST_POLL_INTERVAL=0.5

# --- auth ---
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- auction rules ---
EXTENSION_SECONDS=60
EXTENSION_WINDOW_SECONDS=60

# --- buckets ---
# Filebase (S3-compatible). S3_URL is the public read base; the bucket name is
# taken from its host, so a separate bucket variable is not needed.
S3_URL=https://your-bucket.s3.filebase.io
S3_ACCESS_TOKEN=your-filebase-access-key
S3_SECRET_KEY=your-filebase-secret-key
REGION=auto
SIGNATURE_VERSION=v4
S3_ENDPOINT_URL=https://s3.filebase.io
# Folder inside the bucket that uploads are written under.
S3_PREFIX=auction
S3_MAX_IMAGE_BYTES=5242880

# Filebase only serves buckets publicly on a paid plan. While false, image
# responses include a time-limited `access_url` instead of a permanent URL.
S3_PUBLIC_READ=false
S3_PRESIGN_TTL_SECONDS=3600